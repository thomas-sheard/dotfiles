{
  "layer": "top",
  //"height": 20,
  //"output": "*",
  //"reload_style_on_change": true,

  "modules-left": ["sway/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["mpris", "memory", "cpu", "battery"],

  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": {
      "focused": "●",
      "default": "○"
    }
  },

  "mpris": {
    "format": "{player_icon} {title} - {artist}",
    "format-paused": "{player_icon} {title} - {artist}",
    "max-length": 40
  },

  // DEPRECATED
  "custom/media": {
    "format": "{}",
    "max-length": 50,
    "exec": "~/.config/waybar/media_module.sh",
    "exec-if": "playerctl status 2>/dev/null | grep -q Playing",
    "on-click": "playerctl play-pause"
  },

  "memory": {
    "interval": 2,
    "format": "{percentage}%",
    "min-length": 3
  },

  "cpu": {
    "interval": 1,
    "max-length": 10,
    "format": "{usage}%",
    "min-length": 3
  },

  "clock": {
    "tooltip-format": "{:%a, %d. %b}"
  },

  "battery": {
    "interval": 4,
    "width": 13,
    "full-at": 80,
    "format": "{capacity}%",
    "min-length": 3
  },

  "volume": {

  },

  "brightness": {

  },

  "custom/arrow1": {
    "format": "",
    "tooltip": false
  },

  "custom/arrow2": {
    "format": "",
    "tooltip": false
  },

  "custom/arrow3": {
    "format": "",
    "tooltip": false
  },

  "custom/arrow4": {
    "format": "",
    "tooltip": false
  },

  "custom/arrow10": {
    "format": "",
    "tooltip": false
  }
}
