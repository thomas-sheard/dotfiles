#!/usr/bin/env python3

# takes colors.toml and generates useful forms (lua, css, sh, etc) 
# to be interpreted externally by all my stuff
# literally just chewing up the theme and spitting it out 
# in an understandable way for each program that needs it

from pathlib import Path
import tomllib

# paths
THEME_ROOT = Path.home() / ".config" / "theme"
COLORS_FILE = THEME_ROOT / "current" / "colors.toml"


# read current theme
with COLORS_FILE.open("rb") as f:
    theme = tomllib.load(f)

colors = theme["colors"]

# generate waybar theme

# destination
WAYBAR_DIR = Path.home() / ".config" / "waybar"
WAYBAR_DIR.mkdir(parents=True, exist_ok=True)

waybar = f"""\
/* Automatically generated. Do not edit. */
/* Source: ~/.config/theme/current/colors.toml */

@define-color background {colors["background"]};
@define-color foreground {colors["foreground"]};
@define-color red {colors["red"]};
@define-color orange {colors["orange"]};
@define-color yellow {colors["yellow"]};
@define-color green {colors["green"]};
@define-color cyan {colors["cyan"]};
@define-color blue {colors["blue"]};
@define-color purple {colors["purple"]};
@define-color magenta {colors["magenta"]};
"""

(WAYBAR_DIR / "theme.css").write_text(waybar)

print(f"generated {WAYBAR_DIR / 'theme.css'}")

# generate tofi theme

TOFI_DIR = Path.home() / ".config" / "tofi"
TOFI_DIR.mkdir(parents=True, exist_ok=True)

tofi = f"""\
text-color = {colors["foreground"]}
selection-color = {colors["green"]}
"""

(TOFI_DIR / "theme.conf").write_text(tofi)

print(f"generated {TOFI_DIR / 'theme.conf'}")

# generate mako theme

MAKO_DIR = Path.home() / ".config" / "mako"
MAKO_DIR.mkdir(parents=True, exist_ok=True)

mako = f"""\
background-color={colors["background"]}
border-color={colors["foreground_muted"]}
text-color={colors["foreground"]}

[urgency=low]
border-color={colors["orange"]}

[urgency=normal]
border-color={colors["green"]}

[urgency=high]
border-color={colors["red"]}
"""

(MAKO_DIR / "colors").write_text(mako)

print(f"generated {MAKO_DIR / 'colors'}")

# generate foot theme

FOOT_DIR = Path.home() / ".config" / "foot"
FOOT_DIR.mkdir(parents=True, exist_ok=True)

def foot_color(name):
    return colors[name].lstrip("#")

foot = f"""\
[colors-dark]

foreground={foot_color("foreground")}
background={foot_color("background")}

regular0={foot_color("background")}
regular1={foot_color("red")}
regular2={foot_color("green")}
regular3={foot_color("yellow")}
regular4={foot_color("blue")}
regular5={foot_color("purple")}
regular6={foot_color("cyan")}
regular7={foot_color("foreground")}

bright0={foot_color("border")}
bright1={foot_color("red")}
bright2={foot_color("green")}
bright3={foot_color("yellow")}
bright4={foot_color("blue")}
bright5={foot_color("purple")}
bright6={foot_color("cyan")}
bright7={foot_color("foreground")}

selection-foreground={foot_color("foreground")}
selection-background={foot_color("selection")}

cursor={foot_color("cursor")} {foot_color("background")}
urls={foot_color("info")}
"""

(FOOT_DIR / "theme.conf").write_text(foot)

print(f"generated {FOOT_DIR / 'theme.conf'}")

# generate sway theme

SWAY_DIR = Path.home() / ".config" / "sway"
SWAY_DIR.mkdir(parents=True, exist_ok=True)

sway = f"""\
set $background {colors["background"]}
set $foreground {colors["foreground"]}
set $border {colors["border"]}
set $indicator {colors["red"]}
"""

(SWAY_DIR / "theme").write_text(sway)

print(f"generated {SWAY_DIR / 'theme'}")

# generate nvim theme

NVIM_DIR = Path.home() / ".config" / "nvim" / "lua" / "core" / "theme"
NVIM_DIR.mkdir(parents=True, exist_ok=True)

nvim = f"""\
return {{
  background = "{colors["background"]}",
  background_dark = "{colors["background_dark"]}",
  background_alt = "{colors["background_alt"]}",

  foreground = "{colors["foreground"]}",
  foreground_muted = "{colors["foreground_muted"]}",

  red = "{colors["red"]}",
  orange = "{colors["orange"]}",
  yellow = "{colors["yellow"]}",
  green = "{colors["green"]}",
  cyan = "{colors["cyan"]}",
  blue = "{colors["blue"]}",
  purple = "{colors["purple"]}",
  magenta = "{colors["magenta"]}",

  border = "{colors["border"]}",
  selection = "{colors["selection"]}",
  cursor = "{colors["cursor"]}",

  error = "{colors["error"]}",
  warning = "{colors["warning"]}",
  info = "{colors["info"]}",
  success = "{colors["success"]}",
}}
"""

(NVIM_DIR / "palette.lua").write_text(nvim)

print(f"generated {NVIM_DIR / 'palette.lua'}")

