#!/usr/bin/env bash

set -euo pipefail

THEME_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}/theme"
THEMES_DIR="$THEME_ROOT/themes"
CURRENT="$THEME_ROOT/current"

generate() {
    "$THEME_ROOT/generate.py"
}

current() {
    if [[ -L "$CURRENT" ]]; then
        basename "$(readlink "$CURRENT")"
    else
        echo "no theme currently selected"
    fi
}

list_themes() {
    find "$THEMES_DIR" -mindepth 1 -maxdepth 1 -type d \
        -printf '%f\n' | sort
}

apply() {
    local theme="$1"
    local path="$THEMES_DIR/$theme"

    if [[ ! -d "$path" ]]; then
        echo "error: theme '$theme' does not exist"
        echo
        echo "available themes:"
        list_themes
        exit 1
    fi

    if [[ ! -f "$path/colors.toml" ]]; then
        echo "error: theme '$theme' has no colors.toml"
        exit 1
    fi

    echo "applying theme: $theme"

    ln -sfn "themes/$theme" "$CURRENT"

    generate

    echo "theme applied: $theme"
}


case "${1:-}" in
    current)
        current
        ;;

    list)
        list_themes
        ;;

    generate)
        generate
        ;;

    "")
        echo "usage: theme <theme>"
        echo "       theme current"
        echo "       theme list"
        echo "       theme generate"
        exit 1
        ;;

    *)
        apply "$1"
        ;;
esac
